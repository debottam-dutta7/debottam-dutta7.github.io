@misc{dutta2026tiltpreprint,
  abbr={Preprint},
  title={TILT: Model-Intrinsic Reward Alignment For Compositional Diffusion},
  author={Debottam Dutta and Jianchong Chen and Jaehoon Hahm and Romit Roy Choudhury},
  year={2026},
  note={arXiv, 2026},
  eprint={2607.21606},
  archivePrefix={arXiv},
  primaryClass={cs.AI},
  url={https://arxiv.org/abs/2607.21606},
  pdf={https://arxiv.org/pdf/2607.21606},
  website={https://debottam-dutta7.github.io/tilt_web/},
  selected={false},
  thumbnail={thumb_pushf.png},
  category={Generative Modeling and Sampling},
  tldr={We present TILT (Test-time model-Intrinsic reward aLignment via Tilting), a training-free framework that <span class="hl">poses composition in diffusion as an intrinsic reward alignment problem</span>. The reward is defined purely in distribution space and is thus <span class="hl">modality agnostic</span>: the same reward works across modalities such as image and audio, obviating the need for externally trained reward models. It also yields a closed-form target under a variational approximation, realizable through standard diffusion sampling, and is interpretable, making it amenable to preference-based modifications.}
}

@inproceedings{dutta2026can,
  abbr={ICML Workshop},
  title={Can Intrinsic Rewards Enable Compositional Alignment in Diffusion?},
  author={Debottam Dutta and Jaehoon Hahm and Jianchong Chen and Romit Roy Choudhury},
  year={2026},
  booktitle={ICML 2026 Workshop on Structured Probabilistic Inference {\&} Generative Modeling},
  note={ICML 2026 Workshop on Structured Probabilistic Inference \& Generative Modeling (SPIGM)},
  url={https://openreview.net/forum?id=jRPdGi83MI},
  pdf={https://openreview.net/pdf?id=jRPdGi83MI},
  selected={true},
  thumbnail={tilt.png},
  category={Generative Modeling and Sampling},
  tldr={External rewards used to guide text-to-image generation are not tailored to what the generator has learned. <span class="hl">We ask</span>: can a model that composes poorly tell apart its good and bad samples, and can that model-intrinsic signal help it avoid compositional failures?}
}

@misc{dutta2026steerawaymodecollisions,
      abbr={ICLR},
      title={Steer Away From Mode Collisions: Improving Composition In Diffusion Models},
      author={Debottam Dutta and Jianchong Chen and Rajalaxmi Rajagopalan and Yu-Lin Wei and Romit Roy Choudhury},
      year={2026},
      note={ICLR, 2026},
      eprint={2509.25940},
      archivePrefix={arXiv},
      primaryClass={cs.CV},
      url={https://arxiv.org/abs/2509.25940},
      pdf={https://arxiv.org/abs/2509.25940},
      code={https://github.com/debottam-dutta7/co3},
      website={https://debottam-dutta7.github.io/co3_web/},
      selected = {true},
      thumbnail = {co3_thumb.png},
      category={Generative Modeling and Sampling},
      tldr={While text-to-image models can generate stunning visuals, they frequently fail at multi-concept prompts by dropping or overshadowing weaker elements. <span class="hl">We hypothesize</span> this happens because the joint probability distribution overlaps too heavily with single-concept distributions, pulling generation toward a dominant concept. To resolve this without retraining, our Concept-Contrasting Corrector (CO3) steers sampling away from overlapping areas and toward "pure" modes where all concepts achieve a balanced visual presence.}
}

@misc{rajagopalan2026personalizedimagegenerationhumanintheloop,
      abbr={ICML},
      title={Personalized Image Generation via Human-in-the-loop Bayesian Optimization},
      author={Rajalaxmi Rajagopalan and Debottam Dutta and Yu-Lin Wei and Romit Roy Choudhury},
      year={2026},
      note={ICML, 2026},
      eprint={2602.02388},
      archivePrefix={arXiv},
      primaryClass={cs.CV},
      url={https://arxiv.org/abs/2602.02388},
      pdf={https://arxiv.org/abs/2602.02388},
      website={https://annonanom125.github.io/annonAnomrepo/},
      selected = {true},
      thumbnail = {multibo.png},
      category={Generative Modeling and Sampling},
      tldr={MultiBO enables precise image personalization via human-in-the-loop Bayesian optimization. It narrows the generation gap <span class="hl">by observing that</span> even when language-based prompting reaches its limits, humans can still visually identify if a new image $x^+$ is closer to their imagined target $x^*$ than previous attempts. Iterative multi-choice user feedback is then used to guide the diffusion model to the exact desired image without retraining.}
}

@misc{dutta2025evalp,
  title={Learning Energy-based Variational Latent Prior for VAEs},
  author={Debottam Dutta and Chaitanya Amballa and Zhongweiyang Xu and Yu-Lin Wei and Romit Roy Choudhury},
  year={2025},
  note={arXiv, 2025},
  eprint={2510.00260},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  selected={false},
  abbr={Preprint},
  pdf={https://arxiv.org/pdf/2510.00260},
  url={https://arxiv.org/abs/2510.00260},
  thumbnail = {evalp.png},
  category={Generative Modeling and Sampling},
  tldr={To tackle the fundamental "prior hole" problem that severely degrades VAE generation quality, <span class="hl">we introduce</span> EVaLP, a flexible energy-based prior designed to tightly align with the aggregate posterior. <span class="hl">Our key insight</span> is utilizing a variational sampler network to approximate the log-normalization constant, which effectively bypasses computationally expensive MCMC sampling methods. By successfully bridging this prior-posterior mismatch, our approach enables both stable model training and fast, high-quality sample generation.}
}

@inproceedings{xu2024multisource,
  abbr={Neurips Workshop},
  title={Multi-Source Music Generation with Latent Diffusion},
  author={Zhongweiyang Xu and Debottam Dutta and Yu-Lin Wei and Romit Roy Choudhury},
  year={2024},
  booktitle={Audio Imagination: NeurIPS 2024 Workshop AI-Driven Speech, Music, and Sound Generation},
  note={Audio Imagination: NeurIPS 2024 Workshop AI-Driven Speech, Music, and Sound Generation},
  url={https://openreview.net/forum?id=bxzUnfWrgk},
  selected = {true},
  pdf = {https://openreview.net/pdf/740a8c1a4bcef94c3ad6e58c52336c6703883ce2.pdf},
  demo = {https://xzwy.github.io/MSLDMDemo/},
  thumbnail = {mdlm.png},
  category={Generative Modeling and Sampling},
  tldr={<span class="hl">We introduce</span> the Multi-Source Latent Diffusion Model (MSLDM) to resolve the noisy artifacts and poor melodies of waveform-level models by compressing individual instrumental sources into distinct VAE latents. <span class="hl">Our key insight</span> is that training a diffusion model on these concatenated "source latents" captures inter-source harmony significantly better than modeling whole music mixtures, leveraging this compression and noise-robustness to enable highly flexible, high-quality total and partial generation of mutually coherent tracks.}
}

